<?xml version="1.0" encoding="UTF-8"?>
<!--
    ========================================================================
    KONFIGURASI IIS 10.0 (WINDOWS SERVER 2019)
    Sistem Pengurusan Tugasan & Projek PLANMalaysia Perlis
    Memastikan perlindungan direktori rahsia, sekuriti header, dan integrasi PHP FastCGI
    ========================================================================
-->
<configuration>
    <system.webServer>
        
        <!-- Dokumen Lalai -->
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="public/index.php" />
                <add value="index.php" />
                <add value="public/login.php" />
            </files>
        </defaultDocument>

        <!-- Keselamatan Akses Fail Sensitif (Menyekat capaian luar kepada .env, .sql, .log, dll) -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="config" />
                    <add segment="includes" />
                    <add segment="database" />
                    <add segment="logs" />
                    <add segment=".git" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <!-- Tajuk Keselamatan HTTP (Security Headers) -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
            </customHeaders>
        </httpProtocol>

        <!-- Peraturan Penulisan Semula URL (URL Rewrite Rules jika modul diaktifkan di IIS) -->
        <rewrite>
            <rules>
                <!-- Menghala laluan utama ke folder public jika diakses dari root -->
                <rule name="Redirect root to public" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="public/index.php" />
                </rule>
            </rules>
        </rewrite>

        <!-- Tetapan Ralat Terperinci untuk Pentadbir Tempatan Sahaja -->
        <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto" />

    </system.webServer>
</configuration>
