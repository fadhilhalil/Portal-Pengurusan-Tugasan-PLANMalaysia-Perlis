# ========================================================
# PENGATURAN ALAM SEKITAR / ENVIRONMENT SETTINGS (.env)
# SISTEM PORTAL PENGURUSAN TUGASAN & PROJEK
# JABATAN PERANCANGAN BANDAR DAN DESA NEGERI PERLIS (PLANMalaysia @ Perlis)
# ========================================================

# Salin fail ini kepada .env dan isikan maklumat rahsia yang betul
# Jangan sekali-kali memuat naik fail .env ke GitHub!

# 1. PENGATURAN APLIKASI
APP_NAME="Portal Pengurusan PLANMalaysia Perlis"
APP_ENV=production          # development | production
APP_DEBUG=false             # true untuk paparan ralat semasa pembangunan, false untuk keselamatan server
APP_URL=http://localhost/planmalaysia
APP_SECRET_KEY=isi_kunci_rahsia_panjang_sekurang_kurangnya_32_aksara_di_sini

# 2. PENGKALAN DATA MYSQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_planmalaysia_perlis
DB_USERNAME=root
DB_PASSWORD=KatalaluanKuatMySQL2024!
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# 3. KESELAMATAN SESI & KUKI
SESSION_LIFETIME=7200       # Masa tamat sesi dalam saat (7200 = 2 jam)
SESSION_SECURE=false        # Tetapkan true jika menggunakan HTTPS di IIS
SESSION_HTTPONLY=true

# 4. KESELAMATAN TAHAP TINGGI & HAD PERCUBAAN LOGIN
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
